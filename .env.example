# Neon (https://neon.tech) → your project → Connect.
# Pooled connection string (host contains "-pooler") — used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&pool_timeout=30"
# Direct connection string (same, without "-pooler") — used by migrations:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
